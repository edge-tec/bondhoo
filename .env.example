APP_NAME=Bondhoo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jugajug.com
APP_DOMAIN=jugajug.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jugajug_db
DB_USERNAME=jugajug_user
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLUSTER=redis-cluster:6379

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=jugajug-media
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# CLOUDFLARE R2 (Zero Egress Fees for Videos & Off-Site Backups)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=jugajug-offsite-backups-staging
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# OFF-SITE BACKUP STORAGE CONFIGURATION
BACKUP_OFFSITE_DISK=r2
BACKUP_REQUIRE_OFFSITE=true

# =========================================================================
# PHASE 11: AI PLATFORM CONFIGURATION
# =========================================================================
AI_DEFAULT_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# =========================================================================
# PHASE 11: LIVE STREAMING & WEBRTC
# =========================================================================
RTMP_INGEST_URL=rtmp://live.jugajug.com/live
HLS_PLAYBACK_URL=https://live-cdn.jugajug.com/hls
WEBRTC_SIGNALING_URL=wss://live.jugajug.com/webrtc
TURN_SERVER_URL=turn:turn.jugajug.com:3478
TURN_SERVER_SECRET=jugajug_coturn_ephemeral_secret_key_2026
LIVEKIT_SERVER_URL=wss://livekit.jugajug.com
LIVEKIT_API_KEY=jugajug_livekit_key
LIVEKIT_API_SECRET=jugajug_livekit_secret_key_2026
FCM_PROJECT_ID=bondhoo-messenger
FCM_SERVER_KEY=
FCM_CREDENTIALS_FILE=storage/app/firebase-auth.json

# =========================================================================
# PAYMENT GATEWAYS (bKash, Nagad, SSLCommerz, Stripe)
# =========================================================================
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX=true

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# =========================================================================
# PHASE 11: OPENTELEMETRY & OBSERVABILITY
# =========================================================================
OTEL_SERVICE_NAME=jugajug-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_TRACES_SAMPLER=parentbased_always_on

# =========================================================================
# PHASE 11: ACTIVITYPUB FEDERATION
# =========================================================================
FEDERATION_ENABLED=true
FEDERATION_SIGNING_KEY=

# =========================================================================
# PHASE 11: DISASTER RECOVERY & CROSS-REGION S3
# =========================================================================
DR_BACKUP_BUCKET=jugajug-dr-singapore
DR_BACKUP_REGION=ap-southeast-1
PITR_ENABLED=true
