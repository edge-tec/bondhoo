# =====================================================================
# Jugajug Social Network — Production Environment Settings (.env)
# =====================================================================
APP_NAME=Jugajug
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://jugajug.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bn_BD

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------
# ডাটাবেজ কনফিগারেশন (PostgreSQL অথবা MySQL)
# ---------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=jugajug-postgres.internal
DB_PORT=5432
DB_DATABASE=jugajug_prod
DB_USERNAME=jugajug_user
DB_PASSWORD=SUPER_STRONG_PASSWORD_HERE

# ---------------------------------------------------------------------
# রেডিস কনফিগারেশন (Redis Cluster / Sentinel)
# ---------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=jugajug-redis.internal
REDIS_PASSWORD=STRONG_REDIS_PASSWORD
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=jugajug_cache:

# ---------------------------------------------------------------------
# কিউ সিস্টেম (Redis Queue with Priorities)
# ---------------------------------------------------------------------
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------
# ব্রডকাস্টিং ও ওয়েবসকেট (Laravel Reverb)
# ---------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=jugajug_production_app
REVERB_APP_KEY=jugajug_prod_key_9921
REVERB_APP_SECRET=jugajug_prod_secret_8812
REVERB_HOST="ws.jugajug.com"
REVERB_PORT=443
REVERB_SCHEME=https

# ---------------------------------------------------------------------
# অবজেক্ট স্টোরেজ (AWS S3 / Cloudflare R2) ও সিডিএন
# ---------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=jugajug-media-production
AWS_USE_PATH_STYLE_ENDPOINT=false

# CDN ইউআরএল (Cloudflare অথবা CloudFront)
CDN_URL=https://cdn.jugajug.com

# ---------------------------------------------------------------------
# ইমেইল ও নোটিফিকেশন সার্ভিস (Amazon SES / Resend)
# ---------------------------------------------------------------------
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="no-reply@jugajug.com"
MAIL_FROM_NAME="${APP_NAME}"
